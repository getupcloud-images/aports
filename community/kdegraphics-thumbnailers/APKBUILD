# The group tag is just to easily find this APKBUILD by some scripts for automation
# group=kde-applications
maintainer="team/kde <bribbers@disroot.org>"
pkgname=kdegraphics-thumbnailers
pkgver=26.08.2
pkgrel=0
# armhf blocked by qt6-qtdeclarative -> kio
arch="all !armhf"
pkgdesc="Thumbnailers for various graphics file formats"
url="https://www.kde.org/applications/graphics/"
license="GPL-2.0-or-later AND LGPL-2.0-or-later"
makedepends="
	extra-cmake-modules
	karchive-dev
	kdegraphics-mobipocket-dev
	kio-dev
	libkdcraw-dev
	libkexiv2-dev
	qt6-qtbase-dev
	samurai
	"
_repo_url="https://invent.kde.org/graphics/kdegraphics-thumbnailers.git"
source="https://download.kde.org/stable/release-service/$pkgver/src/kdegraphics-thumbnailers-$pkgver.tar.xz"
# No tests
options="!check"

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DDISABLE_MOBIPOCKET=ON # Fails to find kdegraphics-mobipocket
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
af5ba79d1d26c3fc2a5ae16125c9c153cfa0914038e67c96db351c0cf8bdb6e3f132a01a96ba35816bb09b8aceb5fe61651e4331652fe3be66b65bd39371f492  kdegraphics-thumbnailers-26.08.2.tar.xz
"
