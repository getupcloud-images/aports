b5eef3f92e34a3c7ec6ebfdb0941c6f38fc96fd864e7cbe4447dc791180e1278d6b1a164831ccee020482a26bee942df2885450e12a5314ae7bf5a2772b06b62  0001-apk-add-instead-of-apt-get-install.patch
"
