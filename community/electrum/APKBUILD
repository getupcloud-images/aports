# Contributor: Michał Adamski <michal@ert.pl>
# Contributor: Rdbo <rdbodev@gmail.com>
maintainer="Hugo Osvaldo Barrera <hugo@whynothugo.nl>"
pkgname=electrum
pkgver=4.8.2
pkgrel=0
pkgdesc="Lightweight Bitcoin Wallet"
url="https://electrum.org/"
# loongarch64: test fails: 499500000000 != 499520000000
arch="noarch !loongarch64"
license="MIT"
depends="
	libsecp256k1
	py3-aiohttp
	py3-aiohttp-socks
	py3-aiorpcx
	py3-attrs
	py3-certifi
	py3-dnspython
	py3-electrum-aionostr
	py3-jsonpatch
	py3-protobuf
	py3-pycryptodomex
	py3-cryptography
	py3-qrcode
	"
makedepends="
	py3-gpep517
	py3-setuptools
	py3-wheel
	"
checkdepends="
	py3-pyaes
	py3-pytest-xdist
"
subpackages="$pkgname-pyc"
source="
	electrum-$pkgver.tar.gz::https://github.com/spesmilo/electrum/archive/refs/tags/$pkgver.tar.gz
	0001-apk-add-instead-of-apt-get-install.patch
"

case "$CARCH" in
armhf)
	# no py3-qt6 (gui and tests depend on it)
	options="$options !check"
	;;
*)
	subpackages="$subpackages $pkgname-gui"
	checkdepends="$checkdepends py3-qt6"
	;;
esac

gui() {
	pkgdesc="GUI for $pkgname"
	install_if="$pkgname=$pkgver-r$pkgrel" # The GUI will be installed by default, and can
	                                       # be disabled with !electrum-gui
	depends="$pkgname=$pkgver-r$pkgrel py3-qt6"

	mkdir -p "$subpkgdir"
}

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	case "$CARCH" in
	# time-sensitive tests time out.
	riscv64) pytest_opts="--deselect tests/test_onion_message.py::TestOnionMessageManager::test_request_and_reply" ;;
	*) pytest_opts= ;;
	esac
	.testenv/bin/python3 -m pytest -n auto \
		--ignore tests/test_qml_types.py \
		$pytest_opts \
		tests
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

