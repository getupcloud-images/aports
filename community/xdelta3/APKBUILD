# Maintainer: Natanael Copa <ncopa@alpinelinux.org>
pkgname=xdelta3
pkgver=3.2.2
pkgrel=0
pkgdesc="A diff utility which works with binary files"
url="http://xdelta.org/"
arch="all"
license="GPL-2.0-or-later"
subpackages="$pkgname-dev $pkgname-doc"
makedepends="cmake linux-headers samurai xz-dev"
source="https://github.com/jmacd/xdelta/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz"

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=MinSizeRel \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib
	cmake --build build
}

check() {
	ctest --test-dir build/
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
2c4529a2974005864d3496bd482783d4af8627d27992b69a53be857644ad093a0897929bee070f57f34e3ab7276699fffbb6eb149033fc66ab1b158e1a028f1c  xdelta3-3.2.2.tar.gz
"
