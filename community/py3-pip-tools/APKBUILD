maintainer="Hugo Osvaldo Barrera <hugo@whynothugo.nl>"
pkgname=py3-pip-tools
_pkgname=pip_tools
pkgver=7.6.2
pkgrel=0
pkgdesc="Tools to keep your pinned Python dependencies fresh"
url="https://pip-tools.rtfd.io"
arch="noarch"
license="BSD-3-Clause"
source="https://files.pythonhosted.org/packages/source/p/$_pkgname/$_pkgname-$pkgver.tar.gz"
depends="
	py3-build
	py3-click
	py3-pip
	"
makedepends="
	py3-gpep517
	py3-installer
	py3-setuptools_scm
	py3-wheel
	"
checkdepends="py3-pytest-xdist"
subpackages="
	$pkgname-pyc
	$pkgname-bash-completion
	$pkgname-zsh-completion
	$pkgname-fish-completion
	"
builddir="$srcdir/$_pkgname-$pkgver"
# requires every build backend in the universe
options="!check"

build() {
	SETUPTOOLS_SCM_PRETEND_VERSION="$pkgver" \
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2

	# pip-tools needs to be installed to generate shell completions…
	python3 -m venv --clear --without-pip --system-site-packages venv
	./venv/bin/python3 -m installer .dist/*.whl

	_PIP_COMPILE_COMPLETE=bash_source ./venv/bin/pip-compile > pip-compile.bash
	_PIP_COMPILE_COMPLETE=zsh_source ./venv/bin/pip-compile > pip-compile.zsh
	_PIP_COMPILE_COMPLETE=fish_source ./venv/bin/pip-compile > pip-compile.fish

	_PIP_SYNC_COMPLETE=bash_source ./venv/bin/pip-sync > pip-sync.bash
	_PIP_SYNC_COMPLETE=zsh_source ./venv/bin/pip-sync > pip-sync.zsh
	_PIP_SYNC_COMPLETE=fish_source ./venv/bin/pip-sync > pip-sync.fish
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl

	install -Dm644 pip-compile.bash "$pkgdir"/usr/share/bash-completion/completions/pip-compile
	install -Dm644 pip-sync.bash "$pkgdir"/usr/share/bash-completion/completions/pip-sync

	install -Dm644 pip-compile.zsh "$pkgdir"/usr/share/zsh/site-functions/_pip-compile
	install -Dm644 pip-sync.zsh "$pkgdir"/usr/share/zsh/site-functions/_pip-sync

	install -Dm644 pip-compile.fish "$pkgdir"/usr/share/fish/vendor_completions.d/pip-compile.fish
	install -Dm644 pip-sync.fish "$pkgdir"/usr/share/fish/vendor_completions.d/pip-sync.fish
}

sha512sums="
407bf72ea3ab1b873e90967e336ad1797ee266e0845a79fbdfa03203bfcc71ef2e48de9cbff1dda877b5b380f1a8397c26d45ac592fa9d648237846fdb5dc64f  pip_tools-7.6.2.tar.gz
"
