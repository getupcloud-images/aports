79460145f706d3eb244335700a30be2e6862db2bcda042244cf45ec5227956130a366c54a4240167327e33fde4c9fa671305a7f942acedd17e994d24e0612a2b  wallet-engine.patch
b8b6e61ca2b349e529f6254b1fa9d9d4c82298dc9770431f6f05b39c37524a984d95851cb5cf821e0eb6c95ee18915bd496cddb6802f7624c7fde17580f0395a  0001-Upgrade-Rustix-to-1.1.5.patch
"
