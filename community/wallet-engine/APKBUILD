# Maintainer: Milan P. Stanić <mps@arvanta.net>
pkgname=wallet-engine
pkgver=0.0.7
pkgrel=0
pkgdesc="Rust library for Telegram's wallet"
url="https://github.com/i582/wallet-engine"
arch="all !s390x" # s390x: unnecessary
license="MIT OR Apache-2.0"
options="!check net" # tests need network and cargo fetch
makedepends="cargo cargo-auditable"
subpackages="$pkgname-dev"
_commit=e59e0d89d7ee90c388bf36e3334c5b276f396697
_patches_commit=aec474953ff7ee9b6e4cd9b8658288ea86d124f3
source="$pkgname-$pkgver.tar.gz::https://github.com/i582/wallet-engine/archive/$_commit.tar.gz
	wallet-engine.patch::https://raw.githubusercontent.com/desktop-app/patches/$_patches_commit/wallet-engine.patch
	0001-Upgrade-Rustix-to-1.1.5.patch
	"
builddir="$srcdir/wallet-engine-$_commit"

prepare() {
	default_prepare

	cargo fetch --target="$CHOST" --locked
	cargo fetch --manifest-path bindgen/cpp/Cargo.toml --locked
}

build() {
	cargo auditable build --frozen --release --lib

	cargo run --frozen --release \
		--manifest-path bindgen/cpp/bindgen/Cargo.toml -- \
		--library target/release/libwallet_engine.so \
		--out-dir "$builddir"/target/bindings
}

package() {
	install -vDm755 target/release/libwallet_engine.so \
		"$pkgdir"/usr/lib/libwallet_engine.so
}

dev() {
	default_dev

	depends="$pkgname=$pkgver-r$pkgrel"

	install -vDm644 "$builddir"/target/bindings/wallet_engine.hpp \
		"$subpkgdir"/usr/include/wallet_engine/wallet_engine.hpp
	install -vDm644 "$builddir"/target/bindings/wallet_engine.cpp \
		"$subpkgdir"/usr/include/wallet_engine/wallet_engine.cpp
	install -vDm644 "$builddir"/target/bindings/wallet_engine_scaffolding.hpp \
		"$subpkgdir"/usr/include/wallet_engine/wallet_engine_scaffolding.hpp
}

sha512sums="
