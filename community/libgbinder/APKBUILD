maintainer="Bart Ribbers <bribbers@disroot.org>"
pkgname=libgbinder
pkgver=1.1.54
pkgrel=0
pkgdesc="GLib-style interface to binder"
url="https://github.com/mer-hybris/libgbinder"
arch="all"
license="BSD-3-Clause"
makedepends="
	glib-dev
	libglibutil-dev
	"
subpackages="
	$pkgname-dev
	$pkgname-tools
	"
source="https://github.com/mer-hybris/libgbinder/archive/$pkgver/libgbinder-$pkgver.tar.gz"

build() {
	make KEEP_SYMBOLS=1 release pkgconfig
	make -C test/binder-client KEEP_SYMBOLS=1 release
	make -C test/binder-dump KEEP_SYMBOLS=1 release
	make -C test/binder-service KEEP_SYMBOLS=1 release
	make -C test/binder-watch KEEP_SYMBOLS=1 release
}

check() {
	make -C unit test
}

package() {
	make DESTDIR="$pkgdir" install-dev
}

tools() {
	pkgdesc="$pkgdesc (tools)"

	cd "$builddir"
	make DESTDIR="$subpkgdir" -C test/binder-client KEEP_SYMBOLS=1 install
	make DESTDIR="$subpkgdir" -C test/binder-dump KEEP_SYMBOLS=1 install
	make DESTDIR="$subpkgdir" -C test/binder-service KEEP_SYMBOLS=1 install
	make DESTDIR="$subpkgdir" -C test/binder-watch KEEP_SYMBOLS=1 install
}

sha512sums="
a2c6b7e5400a0a3b5b8b440cfb51e29fc6e6b6a332c5054ab8cb3eb867205192aa7158a22cef4c76c02487586562e0134960cc1e71fb2062fa5cb4e8d127e6f4  libgbinder-1.1.54.tar.gz
"
