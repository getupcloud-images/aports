maintainer="Hugo Osvaldo Barrera <hugo@whynothugo.nl>"
pkgname=darkreader
pkgver=4.9.133
pkgrel=1
pkgdesc="Dark Reader Firefox extension"
url="https://darkreader.org/"
arch="noarch"
license="MIT"
makedepends="git npm rollup"
source="dark-reader-$pkgver.tar.gz::https://github.com/darkreader/darkreader/archive/refs/tags/v$pkgver.tar.gz"
options="net" # fetch dependencies

case "$CARCH" in
ppc64le | s390x | x86) options="$options !check" ;; # missing unrs-resolver on npm.
esac

prepare() {
	default_prepare
	npm ci
	rm -rf node_modules/rollup node_modules/@rollup/rollup-*
	ln -s /usr/share/node_modules/rollup node_modules/rollup
}

build() {
	npm run build
}

check() {
	npm test
}

package() {
	install -Dm644 build/release/darkreader-firefox.xpi "$pkgdir/usr/lib/firefox/browser/extensions/addon@darkreader.org.xpi"
}

sha512sums="
e275ee9af34592182547a62934a5499de48ccb9f8520c58ebe50ed1b7329ca65f370d0f4e817bffc6d5be90d16bf5f987e562926a1e54a26c9d8528914058a0c  dark-reader-4.9.133.tar.gz
"
