maintainer="Bart Ribbers <bribbers@disroot.org>"
pkgname=picard
pkgver=3.0.1
pkgrel=0
# armhf blocked by qt6-qtdeclarative -> py3-qt6
arch="all !armhf"
url="https://picard.musicbrainz.org/"
pkgdesc="Official MusicBrainz tagger"
license="GPL-2.0-or-later"
depends="
	chromaprint
	py3-dateutil
	py3-fasteners
	py3-mutagen
	py3-qt6
	py3-yaml
	qt6-qtimageformats
	"
makedepends="
	gettext
	py3-gpep517
	py3-setuptools
	py3-wheel
	python3-dev
	"
checkdepends="py3-pytest"
subpackages="
	$pkgname-lang
	$pkgname-pyc
	"
source="$pkgname-$pkgver.tar.gz::https://github.com/metabrainz/picard/archive/refs/tags/release-$pkgver.tar.gz"
builddir="$srcdir/picard-release-$pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

lang() {
	local pyver=$(python3 -V | sed 's/.*\([0-9]\{1,\}\.[0-9]\{1,\}\)\..*/\1/')
	amove usr/lib/python$pyver/site-packages/picard/locale/
}

sha512sums="
5c67e9cc95e5fac3263a0a8ea004022139368b9e3a3448d52528614b58ee9a2c26a375500730b520ae8acc93414df07062deeb7e25193fbfb3cd4f6595a55f07  picard-3.0.1.tar.gz
"
