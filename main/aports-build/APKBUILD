# Maintainer: Natanael Copa <ncopa@alpinelinux.org>
pkgname=aports-build
pkgver=1.7.0
pkgrel=0
pkgdesc="MQTT based build-on-git-push scripts for Alpine Linux"
url="https://gitlab.alpinelinux.org/alpine/aports-build"
arch="noarch"
license="GPL-2.0-only"
# NOTE: must correspond with _luaver in lua-aports
_luaver=5.5
depends="abuild>2.20.0 build-base mosquitto-clients openssh-client mqtt-exec>=0.6
	rsync lua-aports>=1.2.0 lua$_luaver-cjson lua$_luaver-mqtt-publish pigz git"
makedepends="make"
checkdepends="atf kyua"
install="$pkgname.pre-install"
subpackages="$pkgname-openrc"
source="https://gitlab.alpinelinux.org/alpine/aports-build/-/archive/$pkgver/aports-build-$pkgver.tar.gz"

check() {
	make check
}

package() {
	make install DESTDIR="$pkgdir"

	install -d "$pkgdir"/etc/buildrepo
	cat >"$pkgdir"/etc/buildrepo/config.lua <<-EOF
	-- logurlprefix = "https://build.alpinelinux.org/buildlogs/"
	-- mqttbroker = "localhost"
	-- logtarget = "distfiles.alpinelinux.org:/var/cache/distfiles/buildlogs/"
	EOF
}

sha512sums="
cd2df3a423f1c2e2a4fe69685cfdcac6b57a0b906e8dcd873ca7833cbe796ce771ba0f2c2a19616dbe1b54f3f32a90cdd86f4750271431eda6b7c58495e471d0  aports-build-1.7.0.tar.gz
"
